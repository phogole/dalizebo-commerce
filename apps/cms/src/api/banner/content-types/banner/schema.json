{
  "kind": "collectionType",
  "collectionName": "banners",
  "info": {
    "singularName": "banner",
    "pluralName": "banners",
    "displayName": "Banner",
    "description": "Editorial campaign or promotional banner."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "copy": {
      "type": "text"
    },
    "media": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "ctaLabel": {
      "type": "string",
      "maxLength": 80
    },
    "ctaUrl": {
      "type": "string",
      "maxLength": 500
    },
    "campaignKey": {
      "type": "string",
      "maxLength": 120,
      "description": "Optional editorial campaign key; it is not a price or promotion rule."
    },
    "startsAt": {
      "type": "datetime"
    },
    "endsAt": {
      "type": "datetime"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "sortOrder": {
      "type": "integer",
      "default": 0,
      "min": 0
    }
  }
}
