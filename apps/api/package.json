{
  "name": "@dalizebo/api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "echo \"Add Playwright/API e2e suite in Sprint 3\"",
    "search:reindex": "tsx src/scripts/search-reindex.ts",
    "search:configure": "tsx src/scripts/search-configure.ts",
    "search:consume": "tsx src/scripts/search-events-consumer.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@dalizebo/auth": "workspace:*",
    "@dalizebo/payments": "workspace:*",
    "@dalizebo/types": "workspace:*",
    "@fastify/cors": "^11.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "fastify": "^5.0.0",
    "ioredis": "^5.0.0",
    "meilisearch": "^0.49.0",
    "pg": "^8.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
